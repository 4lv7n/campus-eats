# Copy this file to ".env" and fill in your own values. NEVER commit ".env".
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/campus_food
# Use a long random string, e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000
