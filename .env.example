# ============================================================
# CAMPUS EATS - environment variables
# Copy the right part into the right file. NEVER commit real .env files.
# ============================================================

# ---------- backend/.env ----------
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/campus_food
# Make a long random secret:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# The website address that is allowed to call the API (CORS)
FRONTEND_URL=http://localhost:3000

# ---------- frontend/.env.local ----------
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:4000/graphql

# ---------- docker-compose.yml reads this root .env file ----------
# (JWT_SECRET, FRONTEND_URL, NEXT_PUBLIC_* from above are used)
